---
import LevelBadge from './LevelBadge.astro';
import { levels, levelMeta, type Module } from '../data/modules';
import { dt } from '../i18n/data-translations';
import type { Locale } from '../i18n';
import { localizePath } from '../i18n';
import { deepTranslate } from '../i18n/module-translations';

interface Props {
  locale: Locale;
  modules: Module[];
}

const { locale, modules } = Astro.props as Props;
const tLevelMeta = Object.fromEntries(
  Object.entries(levelMeta).map(([k, v]) => [k, { label: deepTranslate(v.label, locale), description: deepTranslate(v.description, locale) }])
) as typeof levelMeta;
---

<div class="w-full relative group">
  <!-- Horizontal Scroll Indicator for Mobile Devices -->
  <div class="md:hidden absolute top-2 right-2 z-20 pointer-events-none animate-pulse">
    <span class="inline-flex items-center gap-1 bg-brand-black/90 text-brand-yellow text-[10px] font-mono px-2.5 py-1 rounded-full shadow-lg">
      {dt(locale, 'courseMatrix.swipeHint')}
    </span>
  </div>

  <!-- Right edge gradient shadow for scroll indication -->
  <div class="absolute right-0 top-0 bottom-0 w-8 bg-gradient-to-l from-brand-black/5 to-transparent pointer-events-none md:hidden z-10"></div>

  <div class="overflow-x-auto -mx-4 px-4 md:mx-0 md:px-0">
    <table
      class="course-matrix w-full min-w-[720px] border-separate border-spacing-0"
    >
      <caption class="sr-only">
        {dt(locale, 'courseMatrix.srCaption')}
      </caption>
      <thead>
        <tr>
          <th class="w-[160px] p-2"><span class="sr-only">{dt(locale, 'courseMatrix.srHeader')}</span></th>
          {
            levels.map((lvl) => (
              <th scope="col" class="p-2 align-bottom">
                <div class="flex flex-col items-start gap-1.5 px-3 py-3 rounded-xl panel-light">
                  <LevelBadge level={lvl} label={lvl} size="md" />
                  <span class="text-[11px] text-brand-black/70 leading-tight">
                    {tLevelMeta[lvl].description}
                  </span>
                </div>
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          modules.map((m, i) => (
            <tr class:list={['matrix-row', i === 0 && 'matrix-row-m0']}>
              <th scope="row" class="p-2 align-top">
                <a
                  href={localizePath(locale, `/courses/${m.slug}`)}
                  class="group matrix-head focus-ring block text-left px-3 py-3 rounded-xl panel-light panel-interactive h-full"
                >
                  <div class="flex items-center gap-2 mb-2">
                    <span
                      class:list={[
                        'module-tile module-tile--sm',
                        m.accent === 'red'
                          ? 'module-tile--red'
                          : 'module-tile--dark',
                      ]}
                    >
                      {m.code}
                    </span>
                  </div>
                  <span class="block text-sm font-bold leading-tight text-brand-black">
                    {m.title}
                  </span>
                  {m.id === 'm0' && (
                    <span class="mt-1 block font-mono text-[10px] text-brand-black/50">
                      {dt(locale, 'courseMatrix.platformLayers')}
                    </span>
                  )}
                </a>
              </th>
              {levels.map((lvl) => {
                const cell = m.cells[lvl];
                return (
                  <td class="p-2 align-top">
                    <div class:list={['matrix-cell p-3 h-full flex flex-col gap-2', cell.comingSoon && 'matrix-cell--soon']}>
                      <div class="flex items-start justify-between gap-2">
                        <h4 class="font-semibold text-sm leading-tight text-brand-black">
                          {cell.title}
                        </h4>
                        {cell.comingSoon ? (
                          <span class="text-[10px] font-semibold font-mono text-brand-black/55 px-1.5 py-0.5 rounded shrink-0 border border-dashed border-brand-black/30">
                            {dt(locale, 'courseMatrix.comingSoon')}
                          </span>
                        ) : (
                          <span class="text-[10px] font-semibold font-mono bg-white/70 text-brand-black/80 px-1.5 py-0.5 rounded shrink-0">
                            {cell.durationDays}d
                          </span>
                        )}
                      </div>
                      <p class="text-xs text-brand-black/70 line-clamp-2">{cell.subtitle}</p>
                      <ul class="text-xs text-brand-black/85 space-y-0.5 mt-auto">
                        {cell.outcomes.slice(0, 2).map((o) => (
                          <li>· {o}</li>
                        ))}
                      </ul>
                    </div>
                  </td>
                );
              })}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</div>

<style>
  .course-matrix th,
  .course-matrix td {
    vertical-align: top;
  }

  /* v2.1 §2.5 — Column background by L level (levels are now columns) */
  .course-matrix tbody td:nth-child(2) {
    background-color: var(--color-brand-yellow-light);
  }
  .course-matrix tbody td:nth-child(3) {
    background-color: var(--color-brand-yellow-mid);
  }
  .course-matrix tbody td:nth-child(4) {
    background-color: var(--color-brand-red-light);
  }

  /* v2.1 §2.5 — M0 row top accent (was left column accent before row/col swap) */
  .course-matrix .matrix-row-m0 > th {
    border-top: 4px solid var(--color-brand-red);
  }

  /* Cell interior — transparent so column color shows through */
  .matrix-cell {
    min-height: 120px;
    border-radius: 8px;
    background: transparent;
    transition:
      box-shadow var(--dur-med) var(--ease-standard),
      transform var(--dur-med) var(--ease-standard);
  }
  .matrix-cell:hover {
    box-shadow: var(--shadow-xs);
    transform: translateY(-1px);
  }

  /* Coming-soon cell — dashed + dimmed, reads as intentional */
  .matrix-cell--soon {
    opacity: 0.6;
    border: 1px dashed var(--color-neutral-4);
  }
  .matrix-cell--soon:hover {
    box-shadow: none;
    transform: none;
  }
</style>
