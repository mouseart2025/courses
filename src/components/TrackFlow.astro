---
import { Icon } from 'astro-icon/components';
import type { Track } from '../data/tracks';
import type { Module } from '../data/modules';
import { dt } from '../i18n/data-translations';
import type { Locale } from '../i18n';
import { localizePath } from '../i18n';

interface Props {
  locale: Locale;
  tracks: Track[];
  modules: Module[];
}

const { locale, tracks, modules } = Astro.props as Props;

function getModuleFn(id: string): Module | undefined {
  return modules.find((m) => m.id === id);
}
---

<div class="space-y-6">
  <div class="flex items-center gap-3 text-sm text-neutral-7">
    <span class="font-semibold text-brand-black">{dt(locale, 'trackFlow.title')}</span>
    <span>{dt(locale, 'trackFlow.subtitle')}</span>
  </div>

  <div class="grid gap-4 md:grid-cols-3">
    {
      tracks.map((track) => (
        <div class="card-hairline bg-background p-4 flex flex-col gap-3">
          <div class="flex items-center gap-2">
            <span class="text-xs font-mono font-bold text-brand-red">{track.tagline}</span>
          </div>
          <h4 class="text-base font-bold text-brand-black">{dt(locale, `track.${track.id}.name`)}</h4>
          <p class="text-xs text-neutral-7 flex-1">{dt(locale, `track.${track.id}.desc`)}</p>
          <div class="flex flex-wrap gap-2 mt-2">
            {track.moduleIds.map((id) => {
              const m = getModuleFn(id);
              return (
                <span class="module-tile module-tile--sm module-tile--dark">{m?.code ?? id}</span>
              );
            })}
          </div>
          <a
            href={localizePath(locale, `/paths#track-${track.id}`)}
            class="focus-ring mt-auto inline-flex items-center gap-1 text-xs font-semibold text-brand-black hover:text-brand-red transition-colors"
          >
            {dt(locale, 'trackFlow.viewCombo')}
            <Icon name="lucide:arrow-right" class="w-3 h-3" />
          </a>
        </div>
      ))
    }
  </div>
</div>