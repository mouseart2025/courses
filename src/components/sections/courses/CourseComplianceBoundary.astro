---
import { Icon } from 'astro-icon/components';
import type { Module } from '../../../data/modules';
import type { Locale } from '../../../i18n';
import { t } from '../../../i18n';

interface Props {
  module: Module;
  locale: Locale;
}

const { module, locale } = Astro.props as Props;
const boundary = module.complianceBoundary;
---

{
  boundary && (
    <section class="py-14 md:py-20 px-4 sm:px-6 lg:px-8 border-t border-neutral-3">
      <div class="max-w-6xl mx-auto" data-reveal>
        <header class="max-w-3xl text-left mb-10 md:mb-14">
          <h2 class="section-flag text-3xl md:text-4xl lg:text-5xl font-bold leading-tight text-brand-black">
            {t(locale, 'course.complianceBoundary')}
          </h2>
        </header>

        {boundary.principles && boundary.principles.length > 0 && (
          <div class="mb-8 border-l-4 border-brand-red bg-surface rounded-r-lg px-6 py-5 max-w-3xl">
            <p class="text-xs font-mono font-bold uppercase tracking-widest text-brand-red mb-2">
              {t(locale, 'course.compliance.principles')}
            </p>
            {boundary.principles.map((p) => (
              <p class="text-base md:text-lg font-semibold text-brand-black leading-relaxed">{p}</p>
            ))}
          </div>
        )}

        <div class="grid md:grid-cols-2 gap-6">
          {/* 适用范围 */}
          <div class="bg-card border border-neutral-3 rounded-lg p-6 shadow-sm-soft">
            <div class="flex items-center gap-2 mb-4">
              <Icon name="lucide:check-circle-2" class="w-5 h-5 text-emerald-600" aria-hidden="true" />
              <h3 class="text-lg font-bold text-brand-black tracking-tight">
                {t(locale, 'course.compliance.applicable')}
              </h3>
            </div>
            <ul class="space-y-3">
              {boundary.applicable.map((item) => (
                <li class="flex gap-3 text-sm text-neutral-8 leading-relaxed">
                  <Icon
                    name="lucide:check"
                    class="w-4 h-4 text-emerald-600 mt-0.5 shrink-0"
                    aria-hidden="true"
                  />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          {/* 不适用范围 */}
          <div class="bg-card border border-neutral-3 rounded-lg p-6 shadow-sm-soft">
            <div class="flex items-center gap-2 mb-4">
              <Icon name="lucide:x-circle" class="w-5 h-5 text-brand-red" aria-hidden="true" />
              <h3 class="text-lg font-bold text-brand-black tracking-tight">
                {t(locale, 'course.compliance.notApplicable')}
              </h3>
            </div>
            <ul class="space-y-3">
              {boundary.notApplicable.map((item) => (
                <li class="flex gap-3 text-sm text-neutral-8 leading-relaxed">
                  <Icon
                    name="lucide:x"
                    class="w-4 h-4 text-brand-red mt-0.5 shrink-0"
                    aria-hidden="true"
                  />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>
  )
}
