---
import SectionHeader from '../../SectionHeader.astro';
import type { Module } from '../../../data/modules';
import { dt } from '../../../i18n/data-translations';
import type { Locale } from '../../../i18n';

interface Props {
  module: Module;
  locale: Locale;
}

const { module, locale } = Astro.props as Props;
const intro = module.hardwareIntro;
const title = intro?.title ?? dt(locale, 'course.hardwareIntroTitle');
const subtitle = intro?.subtitle ?? dt(locale, 'course.hardwareIntroSubtitle');
---

{
  intro && (
    <section class="py-14 md:py-20 px-4 sm:px-6 lg:px-8 border-t border-neutral-3 bg-surface">
      <div class="max-w-6xl mx-auto" data-reveal>
        <SectionHeader title={title} subtitle={subtitle} />

        <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {intro.items.map((item, i) => (
            <li
              class="flex flex-col bg-card border border-neutral-3 rounded-lg overflow-hidden shadow-sm-soft"
              data-reveal
              style={`--reveal-delay: ${(i % 3) * 70}ms`}
            >
              <div class="aspect-[4/3] w-full bg-white border-b border-neutral-3 overflow-hidden">
                <img
                  src={item.image}
                  alt={item.imageAlt}
                  width="1200"
                  height="900"
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-contain"
                />
              </div>
              <div class="p-5 flex flex-col grow">
                <h3 class="text-base md:text-lg font-bold text-brand-black tracking-tight">
                  {item.name}
                </h3>
                <p class="mt-1 text-xs font-semibold text-brand-red">{item.note}</p>
                <p class="mt-3 text-sm text-neutral-8 leading-relaxed">{item.description}</p>
              </div>
            </li>
          ))}
        </ul>

        {intro.note && (
          <p class="mt-6 text-sm text-neutral-7 max-w-3xl leading-relaxed">
            {intro.note}
          </p>
        )}
      </div>
    </section>
  )
}