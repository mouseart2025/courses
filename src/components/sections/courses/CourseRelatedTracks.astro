---
import { Icon } from 'astro-icon/components';
import SectionHeader from '../../SectionHeader.astro';
import type { Track } from '../../../data/tracks';
import { dt } from '../../../i18n/data-translations';
import type { Locale } from '../../../i18n';
import { localizePath } from '../../../i18n';

interface Props {
  relatedTracks: Track[];
  locale: Locale;
}

const { relatedTracks, locale } = Astro.props as Props;
---

{
  relatedTracks.length > 0 && (
    <section class="py-16 md:py-24 px-4 sm:px-6 lg:px-8 bg-neutral-1 border-t border-neutral-3">
      <div class="max-w-6xl mx-auto" data-reveal>
        <SectionHeader
          title={dt(locale, 'course.relatedTracks')}
        />
        <div class="grid md:grid-cols-2 gap-6 mt-8">
          {relatedTracks.map((t) => (
            <a
              href={localizePath(locale, `/paths#track-${t.id}`)}
              class="group panel-light panel-interactive border border-neutral-3 hover:border-brand-black/30 p-5 flex items-center gap-4 focus-ring"
              aria-label={`${dt(locale, 'course.relatedTracksAria')}: ${dt(locale, `track.${t.id}.name`)}`}
            >
              <Icon
                name="lucide:route"
                class="w-6 h-6 text-brand-red shrink-0 animate-pulse"
              />
              <div class="flex-1 min-w-0">
                <h4 class="font-black text-brand-black text-base">{dt(locale, `track.${t.id}.name`)}</h4>
                <p class="text-xs font-mono text-neutral-6 mt-0.5">
                  {t.tagline}
                </p>
              </div>
              <Icon name="lucide:arrow-right" class="w-4 h-4 text-neutral-5 group-hover:text-brand-black transition-colors" />
            </a>
          ))}
        </div>
      </div>
    </section>
  )
}