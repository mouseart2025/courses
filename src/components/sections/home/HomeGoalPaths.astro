---
import { Icon } from 'astro-icon/components';
import SectionHeader from '../../SectionHeader.astro';
import type { Track } from '../../../data/tracks';
import type { Module } from '../../../data/modules';
import { dt } from '../../../i18n/data-translations';
import type { Locale } from '../../../i18n';
import { localizePath } from '../../../i18n';

interface Props {
  tracks: Track[];
  locale: Locale;
  modules: Module[];
}

const { tracks, locale, modules } = Astro.props as Props;
const codeOf = (id: string) => modules.find((m) => m.id === id)?.code ?? id;
---

<section class="py-20 px-4 sm:px-6 lg:px-8 bg-background">
  <div class="max-w-6xl mx-auto" data-reveal>
    <SectionHeader
      title={dt(locale, 'home.paths.title')}
      subtitle={dt(locale, 'home.paths.subtitle')}
    />

    <ul class="mt-10 grid gap-5 md:grid-cols-3">
      {tracks.map((t, i) => (
        <li data-reveal style={`--reveal-delay: ${i * 70}ms`}>
          <a
            href={localizePath(locale, `/paths#track-${t.id}`)}
            class="focus-ring group card-hairline flex h-full flex-col p-6 transition-colors hover:border-brand-black/30"
          >
            <p class="text-xs font-mono font-semibold uppercase tracking-widest text-brand-red mb-2">
              {t.tagline}
            </p>
            <h3 class="text-lg md:text-xl font-bold text-brand-black leading-tight">
              {dt(locale, `track.${t.id}.name`)}
            </h3>
            <p class="mt-1 text-sm text-neutral-7">{dt(locale, `track.${t.id}.goal`)}</p>
            <p class="mt-3 text-sm leading-relaxed text-neutral-8">{dt(locale, `track.${t.id}.desc`)}</p>

            <div class="mt-5 flex flex-wrap items-center gap-2">
              {t.moduleIds.map((id) => (
                <span class="module-tile module-tile--dark font-mono text-xs px-2 py-1">
                  {codeOf(id)}
                </span>
              ))}
            </div>

            <span class="mt-auto pt-5 inline-flex items-center gap-1 text-sm font-semibold text-brand-black group-hover:text-brand-red transition-colors">
              {dt(locale, 'home.paths.view')}
              <Icon name="lucide:arrow-right" class="w-4 h-4 transition-transform group-hover:translate-x-0.5" />
            </span>
          </a>
        </li>
      ))}
    </ul>

    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href={localizePath(locale, '/paths')}
        class="focus-ring inline-flex items-center justify-center gap-2 rounded-md bg-brand-red px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-brand-red-hover"
      >
        {dt(locale, 'home.paths.cta1')}
        <Icon name="lucide:arrow-right" class="w-4 h-4" />
      </a>
      <a
        href="/courses"
        class="focus-ring inline-flex items-center justify-center gap-2 rounded-md border border-neutral-3 px-5 py-2.5 text-sm font-semibold text-brand-black transition-colors hover:border-brand-black/30 bg-background"
      >
        {dt(locale, 'home.paths.cta2')}
      </a>
    </div>
  </div>
</section>