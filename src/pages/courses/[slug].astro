---
import Layout from '../../layouts/Layout.astro';
import CourseAudienceSection from '../../components/sections/courses/CourseAudienceSection.astro';
import CourseCapabilities from '../../components/sections/courses/CourseCapabilities.astro';
import CourseComplianceBoundary from '../../components/sections/courses/CourseComplianceBoundary.astro';
import CourseCurriculum from '../../components/sections/courses/CourseCurriculum.astro';
import CourseDetailFactsStrip from '../../components/sections/courses/CourseDetailFactsStrip.astro';
import CourseDetailHero from '../../components/sections/courses/CourseDetailHero.astro';
import CourseDetailPanels from '../../components/sections/courses/CourseDetailPanels.astro';
import CourseDeliverables from '../../components/sections/courses/CourseDeliverables.astro';
import CourseFormats from '../../components/sections/courses/CourseFormats.astro';
import CourseHardware from '../../components/sections/courses/CourseHardware.astro';
import CourseKits from '../../components/sections/courses/CourseKits.astro';
import CourseLearningLadder from '../../components/sections/courses/CourseLearningLadder.astro';
import CourseRelatedTracks from '../../components/sections/courses/CourseRelatedTracks.astro';
import CourseTeacherNotes from '../../components/sections/courses/CourseTeacherNotes.astro';
import CourseToolchain from '../../components/sections/courses/CourseToolchain.astro';
import FinalCtaSection from '../../components/sections/FinalCtaSection.astro';
import { modules, type Module } from '../../data/modules';
import { getTracksForModule } from '../../data/tracks';
import type { FinalCta } from '../../data/site';
import { t, defaultLocale, localeHtmlLang, localizePath } from '../../i18n';
import type { Locale } from '../../i18n';
import { translateModule } from '../../i18n/helpers';

export const prerender = false;

interface Props {
  module?: Module;
}

const slug = Astro.params.slug as string;
const locale = (Astro.locals.locale ?? defaultLocale) as Locale;
const rawModule = Astro.props.module ?? modules.find((m) => m.slug === slug);
if (!rawModule) {
  return Astro.redirect('/404');
}
const module = translateModule(rawModule, locale);
const relatedTracks = getTracksForModule(module.id);
const totalDays = Object.values(module.cells).reduce(
  (sum, cell) => sum + cell.durationDays,
  0,
);

const courseDetailCta: FinalCta = {
  title: `${module.code} ${module.title}`,
  description: t(locale, 'course.cta.primary'),
  primary: { label: t(locale, 'course.cta.primary'), href: localizePath(locale, '/contact') },
  secondary: { label: t(locale, 'course.cta.secondary'), href: localizePath(locale, '/courses') },
};

const siteOrigin = (Astro.site?.toString() ?? 'https://opc.chaihuo.org/').replace(/\/$/, '');
const courseUrl = locale === defaultLocale
  ? `${siteOrigin}/courses/${module.slug}`
  : `${siteOrigin}/${locale}/courses/${module.slug}`;

const courseJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: `${module.code} · ${module.title}`,
  description: `${module.oneLiner.replace(/。$/, '')}。${module.realProblem}`,
  url: courseUrl,
  inLanguage: localeHtmlLang[locale],
  courseCode: module.code,
  about: module.subtitle,
  teaches: module.capabilities,
  timeRequired: `P${totalDays}D`,
  educationalLevel: ['Beginner', 'Intermediate', 'Advanced'],
  provider: {
    '@type': 'Organization',
    name: 'Chaihuo Maker Academy',
    url: siteOrigin,
    sameAs: ['https://www.chaihuo.org', 'https://www.seeedstudio.com'],
  },
  audience: module.audience.map((role) => ({
    '@type': 'EducationalAudience',
    educationalRole: role,
  })),
  hasPart: Object.entries(module.cells).map(([levelId, cell]) => ({
    '@type': 'Course',
    name: `${module.code} · ${levelId} · ${cell.title}`,
    description: cell.subtitle,
    timeRequired: `P${cell.durationDays}D`,
    teaches: cell.outcomes,
    inLanguage: localeHtmlLang[locale],
  })),
};

const courseJsonLdSafe = JSON.stringify(courseJsonLd).replace(/</g, '\\u003c');
---

<Layout title={`${module.code} · ${module.title}`}>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={courseJsonLdSafe}
  />
  <CourseDetailHero module={module} totalDays={totalDays} locale={locale} />
  <CourseDetailFactsStrip module={module} locale={locale} />
  {module.capabilityCards ? (
    <CourseCapabilities module={module} locale={locale} />
  ) : (
    <CourseDetailPanels module={module} locale={locale} />
  )}
  {module.hardwareIntro && <CourseHardware module={module} locale={locale} />}
  <CourseToolchain module={module} locale={locale} />
  {module.kits ? <CourseKits module={module} locale={locale} /> : <CourseLearningLadder module={module} locale={locale} />}
  <CourseCurriculum module={module} locale={locale} />
  <CourseFormats module={module} locale={locale} />
  <CourseDeliverables module={module} locale={locale} />
  <CourseAudienceSection module={module} locale={locale} />
  <CourseTeacherNotes module={module} locale={locale} />
  <CourseComplianceBoundary module={module} locale={locale} />
  <CourseRelatedTracks relatedTracks={relatedTracks} locale={locale} />
  <FinalCtaSection cta={courseDetailCta} bordered />
</Layout>