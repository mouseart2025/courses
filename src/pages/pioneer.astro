        { q: 'Cual es la relacion entre Pioneer y base?', a: 'Toda base debe tener primero un Pioneer. Los Pioneers pueden ser empleados de la base o socios. Un Pioneer puede afiliarse a multiples bases; los beneficios de base se comparten entre los Pioneers de esa base.' },
      ],
    },
    finalCta: { eyebrow: 'Lleva este programa a tu ciudad', title: 'Fase 1: 10 bases + 20 Pioneers', description: 'Envia el formulario de solicitud. Un community manager te contactara en 3 dias habiles.', primary: 'Aplicar como Pioneer', secondary: 'Contactanos' },
  },
  'pt-BR': {
    hero: { eyebrow: 'Programa Pioneer', title: 'Seja o acendedor da era IA na sua cidade', subtitle: 'Com conhecimento tecnico e capacidade de ensinar, ou com conexoes locais em educacao — Chaihuo te da curriculo, hardware e certificacao. Voce leva a educacao maker de IA para sua cidade.' },
    whatIs: {
      title: 'O que e um Pioneer', subtitle: 'Comunicador tecnico local + provedor de servicos certificado pela Chaihuo',
      definition: 'Toda base deve primeiro ter um Pioneer. Pioneers tambem podem operar independentemente sem base.',
      types: [
        { label: 'Tecnico', title: 'Perfil tecnico', body: 'Quer usar habilidades maker para educacao / servicos, pode ensinar e liderar projetos diretamente.' },
        { label: 'Conector', title: 'Recursos educacionais / comunitarios', body: 'Quer introduzir cursos maker mas nao necessariamente ensina; gerencia inscricoes locais e operacoes de sede.' },
      ],
      note: 'Ambos os papeis podem se sobrepor ou formar equipe — um tecnico + um conector e a combinacao inicial mais comum.',
    },
    benefits: {
      title: 'O que voce recebe', subtitle: 'Tudo necessario para comecar: hardware, contas, curriculo, certificacao',
      items: [
        { icon: 'package', title: 'Kits de Hardware M0 x5', body: 'Gratis, sem devolucao. Inclui Grove Beginner Kit, Wio Terminal, XIAO ESP32S3 Sense — tres plataformas.' },
        { icon: 'users', title: 'Contas Codecraft x5', body: '365 dias / 5 assentos. No navegador, zero instalacao, programacao assistida por IA.' },
        { icon: 'file-text', title: 'Pacote de Curriculo', body: 'PPT + Markdown, totalmente personalizavel. Esqueleto de 10 modulos + planos de aula + manual do aluno.' },
        { icon: 'award', title: 'Certificacao Oficial', body: 'Ao aprovar, publicado no mapa global map.seeed.cc com respaldo de Pioneer Chaihuo.' },
        { icon: 'headphones', title: 'Suporte da Sede Central', body: 'Community manager dedicado, canal de consultas tecnicas, atualizacoes continuas de curriculo.' },
        { icon: 'trending-up', title: 'Rota M1-M6', body: 'Aluguel com deposito, reembolsavel ao sair. De zero bases a seis direcoes industriais, desbloqueie conforme necessidade.' },
      ],
    },
    revenue: {
      title: 'Como gerar renda', subtitle: 'Tres linhas de renda, tres identidades',
      items: [
        { no: '01', title: 'Renda com aulas', body: 'Ministre cursos M0 localmente, 100% da mensalidade e seu. Curriculo e hardware prontos — voce gerencia inscricao e ensino.' },
        { no: '02', title: 'Encomendas da central', body: 'Solicitacoes de treinamento / oficinas recebidas pela Chaihuo sao designadas a Pioneers locais. Voce fornece o trabalho, cobra diretamente.' },
        { no: '03', title: 'Comissao por hardware', body: 'Recomende hardware Chaihuo a escolas / instituicoes locais, ganhe comissao por fechamento. O hardware e a entrada e a renda recorrente.' },
      ],
    },
    steps: {
      title: 'Quatro passos', subtitle: 'De um evento de demonstracao a uma ancora em nivel de cidade',
      items: [
        { no: '1', title: 'Evento de demonstracao', body: 'Organize uma体验 de programacao IA na sua cidade / sede, valide demanda local e seu ritmo docente.' },
        { no: '2', title: 'Formacao e certificacao', body: 'Complete a formacao de instrutores e certificacao (pode comecar online), domine o sistema de curriculo.' },
        { no: '3', title: 'Hardware recebido, aulas oficiais', body: 'Apos certificacao, receba hardware e contas, lance seu primeiro curso pago, complete todo o fluxo.' },
        { no: '4', title: 'Validacao e atualizacao', body: 'Primeira turma bem-sucedida, suporte adicional, quando estiver pronto solicite ser base oficial.' },
      ],
    },
    cert: {
      title: 'Processo de certificacao', subtitle: 'Construa, ensine, depois certifique-se',
      items: [
        { no: '01', title: 'Receber hardware', body: 'Apos assinar, 5 kits M0 sao enviados.' },
        { no: '02', title: 'Completar um projeto', body: 'Construa independentemente um projeto de hardware inteligente demonstravel.' },
        { no: '03', title: 'Gravar video de aula', body: 'Grave um segmento de 10-15 min demonstrando capacidade docente.' },
        { no: '04', title: 'Revisao da central', body: 'Equipe pedagogica Chaihuo revisa completude do projeto e qualidade docente.' },
        { no: '05', title: 'Certificacao emitida', body: 'Aprovada a revisao, recebe certificacao Pioneer, publicado no mapa global.' },
      ],
      note: 'Receber hardware nao te torna Pioneer — voce deve construir e ensinar. Se nao aprovar, pode reenviar apos melhorias.',
    },
    faq: {
      title: 'Perguntas frequentes', subtitle: '',
      items: [
        { q: 'Quantas vagas no primeiro lote?', a: 'Fase 1: 10 bases + 20 Pioneers, por ordem de chegada com avaliacao. Ha muito interesse — candidate-se cedo.' },
        { q: 'E se nao for selecionado?', a: 'Fases 2 e 3 abrirao gradualmente. Tambem pode pagar um deposito para participar como reserva. Candidatos do primeiro lote tem prioridade.' },
        { q: 'Ha custos?', a: 'O hardware M0 e gratuito e sem devolucao. O hardware M1-M6 e aluguel com deposito, reembolsavel ao sair. Valores especificos conforme acordo.' },
        { q: 'Posso ser Pioneer sem saber programar?', a: 'Sim. Codecraft e zero instalacao, no navegador, com IA escrevendo o codigo. Qualquer professor com experiencia docente pode ensinar apos percorrer o fluxo uma vez.' },
        { q: 'Qual a relacao entre Pioneer e base?', a: 'Toda base deve primeiro ter um Pioneer. Pioneers podem ser funcionarios da base ou parceiros. Um Pioneer pode se afiliar a multiplas bases; beneficios de base sao compartilhados entre os Pioneers daquela base.' },
      ],
    },
    finalCta: { eyebrow: 'Leve este programa para sua cidade', title: 'Fase 1: 10 bases + 20 Pioneers', description: 'Envie o formulario de candidatura. Um community manager entrara em contato em 3 dias uteis.', primary: 'Candidatar-se como Pioneer', secondary: 'Fale conosco' },
  },
};

const c = content[locale] ?? content['zh-CN'];

const finalCtaData = {
  eyebrow: c.finalCta.eyebrow,
  title: c.finalCta.title,
  description: c.finalCta.description,
  primary: { label: c.finalCta.primary, href: localizePath(locale, '/contact') },
  secondary: { label: c.finalCta.secondary, href: localizePath(locale, '/courses') },
};
---

<Layout title={t(locale, 'nav.pioneer')}>
  <HeroBanner eyebrow={c.hero.eyebrow} title={c.hero.title} subtitle={c.hero.subtitle} panel="yellow-soft" />

  <section class="py-20 md:py-24 px-4 sm:px-6 lg:px-8 bg-background border-b border-neutral-3">
    <div class="max-w-6xl mx-auto" data-reveal>
      <SectionHeader eyebrow={c.whatIs.title} title={c.whatIs.subtitle} />
      <p class="text-base md:text-lg leading-relaxed text-neutral-8 max-w-3xl mb-10">{c.whatIs.definition}</p>
      <div class="grid md:grid-cols-2 gap-6">
        {c.whatIs.types.map((type) => (
          <div class="border border-neutral-3 rounded-lg bg-card p-6 md:p-8">
            <span class="inline-block text-xs font-mono font-bold uppercase tracking-widest text-brand-red bg-brand-yellow-light px-3 py-1 rounded-full mb-4">{type.label}</span>
            <h3 class="text-xl font-bold text-brand-black mb-3">{type.title}</h3>
            <p class="text-sm leading-relaxed text-neutral-7">{type.body}</p>
          </div>
        ))}
      </div>
      <p class="mt-8 text-sm text-neutral-6 italic">{c.whatIs.note}</p>
    </div>
  </section>

  <section class="py-20 md:py-24 px-4 sm:px-6 lg:px-8 bg-neutral-1 border-b border-neutral-3">
    <div class="max-w-6xl mx-auto" data-reveal>
      <SectionHeader eyebrow={c.benefits.title} title={c.benefits.subtitle} />
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {c.benefits.items.map((item) => (
          <div class="border border-neutral-3 rounded-lg bg-card p-6 hover:border-brand-black/20 transition-colors">
            <div class="w-10 h-10 rounded-lg bg-brand-yellow-light flex items-center justify-center mb-4">
              <Icon name={`lucide:${item.icon}`} class="w-5 h-5 text-brand-red" />
            </div>
            <h3 class="text-base font-bold text-brand-black mb-2">{item.title}</h3>
            <p class="text-sm leading-relaxed text-neutral-7">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 md:py-24 px-4 sm:px-6 lg:px-8 bg-background border-b border-neutral-3">
    <div class="max-w-6xl mx-auto" data-reveal>
      <SectionHeader eyebrow={c.revenue.title} title={c.revenue.subtitle} />
      <div class="grid md:grid-cols-3 gap-6">
        {c.revenue.items.map((item) => (
          <div class="relative border border-neutral-3 rounded-lg bg-card p-6 md:p-8">
            <span class="absolute top-5 right-6 text-4xl font-mono font-black text-brand-yellow/60">{item.no}</span>
            <h3 class="text-lg font-bold text-brand-black mb-3 pr-12">{item.title}</h3>
            <p class="text-sm leading-relaxed text-neutral-7">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 md:py-24 px-4 sm:px-6 lg:px-8 bg-neutral-1 border-b border-neutral-3">
    <div class="max-w-6xl mx-auto" data-reveal>
      <SectionHeader eyebrow={c.steps.title} title={c.steps.subtitle} />
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {c.steps.items.map((item) => (
          <div class="border border-neutral-3 rounded-lg bg-card p-6 h-full">
            <div class="flex items-center gap-3 mb-4">
              <span class="w-8 h-8 rounded-full bg-brand-red text-white text-sm font-bold flex items-center justify-center font-mono">{item.no}</span>
            </div>
            <h3 class="text-base font-bold text-brand-black mb-2">{item.title}</h3>
            <p class="text-sm leading-relaxed text-neutral-7">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 md:py-24 px-4 sm:px-6 lg:px-8 bg-background border-b border-neutral-3">
    <div class="max-w-6xl mx-auto" data-reveal>
      <SectionHeader eyebrow={c.cert.title} title={c.cert.subtitle} />
      <div class="border-l-4 border-brand-red bg-brand-yellow-light/60 px-5 py-4 rounded-r-lg max-w-3xl mb-10">
        <p class="text-sm leading-relaxed text-brand-black">{c.cert.note}</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-4">
        {c.cert.items.map((item) => (
          <div class="border border-neutral-3 rounded-lg bg-card p-5 text-center">
            <span class="block text-2xl font-mono font-black text-brand-red mb-2">{item.no}</span>
            <h4 class="text-sm font-bold text-brand-black mb-2">{item.title}</h4>
            <p class="text-xs leading-relaxed text-neutral-6">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 md:py-24 px-4 sm:px-6 lg:px-8 bg-neutral-1 border-b border-neutral-3">
    <div class="max-w-3xl mx-auto" data-reveal>
      <SectionHeader eyebrow={c.faq.title} title={c.faq.subtitle} align="center" />
      <div class="space-y-4">
        {c.faq.items.map((item) => (
          <div class="border border-neutral-3 rounded-lg bg-card overflow-hidden">
            <details class="group">
              <summary class="flex items-center justify-between cursor-pointer px-5 py-4 text-sm font-bold text-brand-black hover:bg-neutral-1 transition-colors list-none">
                <span>{item.q}</span>
                <Icon name="lucide:chevron-down" class="w-4 h-4 text-neutral-5 shrink-0 transition-transform group-open:rotate-180" />
              </summary>
              <div class="px-5 pb-5 text-sm leading-relaxed text-neutral-7 border-t border-neutral-3 pt-4">{item.a}</div>
            </details>
          </div>
        ))}
      </div>
    </div>
  </section>

  <FinalCtaSection cta={finalCtaData} bordered />
</Layout>
