        { no: '03', title: 'Comision por hardware', body: 'Recomienda hardware Chaihuo a escuelas / instituciones locales, gana comision por cierre. El hardware es la entrada y el ingreso recurrente.' },
      ],
    },
    steps: {
      title: 'Cuatro pasos', subtitle: 'De un evento de demostracion a un ancla a nivel de ciudad',
      items: [
        { no: '1', title: 'Evento de demostracion', body: 'Organiza una体验 de programacion IA en tu ciudad / sede, valida demanda local y tu ritmo docente.' },
